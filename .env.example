APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
API_KEYS=change-this-long-random-key
MAX_UPLOAD_SIZE=52428800
MAX_PAGES=100
MAX_IMAGE_PIXELS=50000000
TEMP_DIR=/data/input
RESULT_DIR=/data/results
RESULT_TTL_SECONDS=86400
TEMP_FILE_TTL_SECONDS=3600
VISION_BACKEND=ollama
DEFAULT_MODEL_PROFILE=default
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=document-ocr
OLLAMA_KEEP_ALIVE=-1
OLLAMA_REQUEST_TIMEOUT=600
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_MAX_RETRIES=2
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=12000
OLLAMA_TEMPERATURE=0
OLLAMA_SEED=42
OLLAMA_MAX_CONCURRENT_REQUESTS=1
LLAMA_CPP_BASE_URL=http://llama-server:8080
LLAMA_CPP_MODEL=document-ocr
REDIS_URL=redis://redis:6379/0
MAX_ACTIVE_DOCUMENTS=2
MAX_PARALLEL_PAGES=1
MAX_QUEUE_SIZE=64
QUEUE_WAIT_TIMEOUT=30
PAGE_PROCESSING_TIMEOUT=600
DOCUMENT_PROCESSING_TIMEOUT=7200
MAX_VISION_RETRIES=2
PDF_RENDER_DPI=300
PREPROCESS_MODE=auto

CLEANUP_INTERVAL_SECONDS=300
CLEANUP_LOCK_TTL_SECONDS=600
RATE_LIMIT_UNAUTHENTICATED_PER_MINUTE=10
